@page "/root"
@model Host.Pages.Root.IndexModel
@{
    ViewData["Title"] = "Root Panel";
    var activeTab = string.Equals(Model.Tab, "inventory", StringComparison.OrdinalIgnoreCase)
        ? "inventory"
        : string.Equals(Model.Tab, "salary", StringComparison.OrdinalIgnoreCase)
            ? "salary"
            : "force";
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Root Panel</title>
    <style>
        :root {
            color-scheme: dark;
            --bg: #0a0f1d;
            --card: #121a2f;
            --card-border: #233053;
            --text: #e8eefc;
            --muted: #9baacf;
            --field-bg: #0b142a;
            --field-border: #33456f;
            --focus: #4e79d8;
            --ok: #2d8a54;
            --warn: #dc6f1b;
            --ghost: #2f3a58;
            --primary: #2d6fdb;
        }
        * { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; }
        body {
            font-family: "Segoe UI", "Noto Sans", sans-serif;
            background:
                radial-gradient(circle at 20% -5%, #263f7a 0%, transparent 35%),
                radial-gradient(circle at 100% 0%, #1a2f5f 0%, transparent 28%),
                var(--bg);
            color: var(--text);
        }
        .wrap { max-width: 1120px; margin: 20px auto; padding: 16px; }
        .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 16px; }
        .tabs { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
        .tab-btn { padding: 10px 14px; border: 1px solid var(--card-border); border-radius: 8px; cursor: pointer; background: #1f2945; color: var(--text); }
        .tab-btn.active { background: var(--primary); border-color: var(--primary); }
        .card { background: var(--card); border: 1px solid var(--card-border); border-radius: 12px; padding: 16px; margin-bottom: 16px; }
        label { display: block; margin: 8px 0 6px 0; color: var(--muted); }
        input, select {
            display: block;
            width: 100%;
            min-height: 42px;
            padding: 10px 12px;
            border: 1px solid var(--field-border);
            border-radius: 10px;
            background: var(--field-bg);
            color: var(--text);
            font: inherit;
        }
        input:focus, select:focus {
            outline: none;
            border-color: var(--focus);
            box-shadow: 0 0 0 3px rgba(78, 121, 216, 0.2);
        }
        .row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
        .row-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
        .actions { margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap; }
        button { padding: 10px 14px; border: 1px solid transparent; border-radius: 8px; cursor: pointer; font: inherit; font-weight: 600; }
        .ok { background: var(--ok); color: #fff; }
        .warn { background: var(--warn); color: #fff; }
        .ghost { background: var(--ghost); border-color: #42527f; color: #fff; text-decoration: none; display: inline-flex; align-items: center; }
        .msg-ok { color: #66bb6a; }
        .msg-err { color: #ef5350; }
        .muted { color: var(--muted); font-size: 0.95rem; }
        .tab { display: none; }
        .tab.active { display: block; }
        .table-wrap { overflow-x: auto; border-radius: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 8px; min-width: 560px; }
        th, td { border-bottom: 1px solid #2e3b5f; text-align: left; padding: 10px 8px; }
        .check-list { max-height: 260px; overflow: auto; border: 1px solid #2e3b5f; border-radius: 8px; padding: 8px; }
        .check-item { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
        .check-item input { width: auto; min-height: auto; }
        @@media (max-width: 860px) {
            .row, .row-3 { grid-template-columns: 1fr; }
            .wrap { padding: 12px; }
            .top h2 { margin: 0; font-size: 1.2rem; }
        }
    </style>
</head>
<body>
<div class="wrap">
    <div class="top">
        <h2>Root Panel</h2>
        <form method="post" asp-page-handler="Logout">
            <button class="ghost" type="submit">Logout</button>
        </form>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="msg-ok">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="msg-err">@Model.ErrorMessage</div>
    }

    <div class="tabs">
        <button class="tab-btn @(activeTab == "force" ? "active" : "")" data-tab="force" type="button" onclick="showTab('force')">Force payout</button>
        <button class="tab-btn @(activeTab == "inventory" ? "active" : "")" data-tab="inventory" type="button" onclick="showTab('inventory')">Inventory</button>
        <button class="tab-btn @(activeTab == "salary" ? "active" : "")" data-tab="salary" type="button" onclick="showTab('salary')">Salary ops</button>
    </div>

    <div id="tab-force" class="tab @(activeTab == "force" ? "active" : "")">
        <div class="card">
            <h3>Force payout (ignore normal rules)</h3>
            <form method="post" asp-page-handler="Force">
                <div class="row">
                    <div>
                        <label>Employee</label>
                        <select name="Force.EmployeeId" required>
                            <option value="">Select employee</option>
                            @foreach (var emp in Model.Employees)
                            {
                                <option value="@emp.Id">@emp.Name (Salary: @emp.CurrentSalary)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>Amount</label>
                        <input name="Force.Amount" type="number" min="1" required />
                    </div>
                </div>

                <div class="row">
                    <div>
                        <label>Comment</label>
                        <input name="Force.Comment" />
                    </div>
                    <div>
                        <label>Options</label>
                        <div class="check-item"><input name="Force.IsSalary" type="checkbox" value="true" /> <span>Salary payout (otherwise advance)</span></div>
                        <div class="check-item"><input name="Force.IsNonCash" type="checkbox" value="true" /> <span>Non-cash (otherwise from safe)</span></div>
                    </div>
                </div>

                <div class="actions">
                    <button class="warn" type="submit">Apply force payout</button>
                </div>
            </form>
        </div>
    </div>

    <div id="tab-inventory" class="tab @(activeTab == "inventory" ? "active" : "")">
        <div class="card">
            <h3>Inventory filter</h3>
            <form method="get">
                <input type="hidden" name="tab" value="inventory" />
                <div class="row-3">
                    <div>
                        <label>From</label>
                        <input type="datetime-local" name="InventoryFrom" value="@(Model.InventoryFrom?.ToString("yyyy-MM-ddTHH:mm"))" />
                    </div>
                    <div>
                        <label>To</label>
                        <input type="datetime-local" name="InventoryTo" value="@(Model.InventoryTo?.ToString("yyyy-MM-ddTHH:mm"))" />
                    </div>
                    <div>
                        <label>Hours (minimum)</label>
                        <input type="number" min="1" name="InventoryHours" value="@(Model.InventoryHours?.ToString() ?? string.Empty)" />
                    </div>
                </div>
                <div class="actions">
                    <button class="ghost" type="submit">Apply filter</button>
                    <a class="ghost" href="/root?tab=inventory">Reset</a>
                </div>
            </form>
            <p class="muted">If hours are set, only employees with at least this amount of worked hours in the selected period are shown.</p>
        </div>

        <div class="card">
            <h3>Inventory</h3>
            <form method="post" asp-page-handler="Inventory">
                <input type="hidden" name="InventoryFrom" value="@(Model.InventoryFrom?.ToString("yyyy-MM-ddTHH:mm"))" />
                <input type="hidden" name="InventoryTo" value="@(Model.InventoryTo?.ToString("yyyy-MM-ddTHH:mm"))" />
                <input type="hidden" name="InventoryHours" value="@(Model.InventoryHours?.ToString() ?? string.Empty)" />

                <div class="row">
                    <div>
                        <label>Total amount</label>
                        <input name="Inventory.TotalAmount" type="number" min="1" required />
                    </div>
                    <div>
                        <label>Comment</label>
                        <input name="Inventory.Comment" />
                    </div>
                </div>

                <label>Employees</label>
                <div class="check-list">
                    @if (Model.InventoryEmployees.Count == 0)
                    {
                        <div class="muted">No employees match the filter.</div>
                    }
                    else
                    {
                        @foreach (var emp in Model.InventoryEmployees)
                        {
                            <label class="check-item">
                                <input type="checkbox" name="Inventory.EmployeeIds" value="@emp.Id" />
                                <span>@emp.Name (Current salary: @emp.CurrentSalary, Period hours: @emp.PeriodHours)</span>
                            </label>
                        }
                    }
                </div>

                <div class="actions">
                    <button class="ok" type="submit">Apply inventory</button>
                </div>
            </form>
        </div>
    </div>

    <div id="tab-salary" class="tab @(activeTab == "salary" ? "active" : "")">
        <div class="card">
            <h3>Manual salary operation</h3>
            <form method="post" asp-page-handler="Salary">
                <div class="row">
                    <div>
                        <label>Employee</label>
                        <select name="Salary.EmployeeId" required>
                            <option value="">Select employee</option>
                            @foreach (var emp in Model.Employees)
                            {
                                <option value="@emp.Id">@emp.Name (Current: @emp.CurrentSalary)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>Amount</label>
                        <input name="Salary.Amount" type="number" min="1" required />
                    </div>
                </div>

                <div class="row">
                    <div>
                        <label>Direction</label>
                        <select name="Salary.IsIncrease">
                            <option value="true">Add salary</option>
                            <option value="false">Subtract salary</option>
                        </select>
                    </div>
                    <div>
                        <label>Category</label>
                        <select name="Salary.Type">
                            <optgroup label="Add">
                                <option value="1">Regular</option>
                                <option value="2">Bonus</option>
                            </optgroup>
                            <optgroup label="Subtract">
                                <option value="3">Advance</option>
                                <option value="4">Inventory</option>
                                <option value="5">Fine</option>
                                <option value="6">Pay</option>
                            </optgroup>
                        </select>
                    </div>
                </div>

                <div>
                    <label>Comment</label>
                    <input name="Salary.Comment" />
                </div>

                <div class="actions">
                    <button class="ok" type="submit">Apply salary operation</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <h3>Employees</h3>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Hourly rate</th>
                        <th>Current salary</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var emp in Model.Employees)
                {
                    <tr>
                        <td>@emp.Name</td>
                        <td>@emp.HourlyRate</td>
                        <td>@emp.CurrentSalary</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function showTab(tab) {
        document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(x => x.classList.remove('active'));
        const tabElement = document.getElementById('tab-' + tab);
        if (tabElement) {
            tabElement.classList.add('active');
        }

        const activeButton = document.querySelector('.tab-btn[data-tab="' + tab + '"]');
        if (activeButton) {
            activeButton.classList.add('active');
        }

        history.replaceState(null, '', '/root?tab=' + tab);
    }
</script>
</body>
</html>
