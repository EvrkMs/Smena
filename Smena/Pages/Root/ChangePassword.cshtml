@page "/root/change-password"
@model Host.Pages.Root.ChangePasswordModel
@{
    ViewData["Title"] = "Смена пароля root";
    ViewData["PageClass"] = "min-h-screen flex items-center justify-center p-6 relative z-10";
}
<div class="auth-card">
    <div class="eyebrow">root / смена пароля</div>
    <h1 class="auth-title">Смена пароля</h1>
    <p class="auth-subtitle">Первый вход с дефолтным паролем требует обязательной смены пароля перед продолжением работы.</p>

    <div asp-validation-summary="All" class="err-block"></div>

    <form method="post">
        <div class="field">
            <div class="field-label"><span class="idx">01</span> Текущий пароль</div>
            <input class="glass-input glass-input-password" asp-for="CurrentPassword" type="password" autocomplete="current-password" placeholder="••••••••" />
        </div>

        <div class="field">
            <div class="field-label"><span class="idx">02</span> Новый пароль</div>
            <input class="glass-input glass-input-password" asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
        </div>

        <div class="field">
            <div class="field-label"><span class="idx">03</span> Подтверждение</div>
            <input class="glass-input glass-input-password" asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
        </div>

        <hr class="divider" />

        <button class="btn btn-primary btn-block" type="submit">
            Сохранить новый пароль
            <span class="arrow">→</span>
        </button>
    </form>

    <a class="back-link" asp-page="/Root/Login">← вернуться ко входу</a>
</div>
