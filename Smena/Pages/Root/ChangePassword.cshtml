@page "/root/change-password"
@model Host.Pages.Root.ChangePasswordModel
@{
    ViewData["Title"] = "Смена пароля root";
}

<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Смена пароля root</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg:           #080d18;
            --surface:      #0e1628;
            --surface-2:    #141f38;
            --border:       #1e2e50;
            --border-focus: #3b6fd4;
            --text:         #dce8ff;
            --text-muted:   #6a84b8;
            --text-dim:     #3d5280;
            --accent:       #3b6fd4;
            --accent-glow:  rgba(59,111,212,.25);
            --accent-hover: #4d7fe0;
            --danger:       #e05c5c;
            --danger-dim:   rgba(224,92,92,.12);
            --success:      #3db87a;
            --mono: "IBM Plex Mono", monospace;
            --sans: "IBM Plex Sans", sans-serif;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            min-height: 100%;
            background: var(--bg);
        }

        body {
            font-family: var(--sans);
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 24px;
            background-image:
                radial-gradient(ellipse 80% 50% at 50% -10%, rgba(59,111,212,.18) 0%, transparent 70%),
                linear-gradient(180deg, #080d18 0%, #07101f 100%);
            position: relative;
            overflow: hidden;
        }

        /* Grid overlay */
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(59,111,212,.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(59,111,212,.04) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        /* Floating orb */
        body::after {
            content: "";
            position: fixed;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(59,111,212,.07) 0%, transparent 70%);
            top: -200px;
            left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
        }

        .card {
            position: relative;
            z-index: 1;
            width: min(100%, 420px);
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 36px 32px 32px;
            box-shadow:
                0 0 0 1px rgba(59,111,212,.05),
                0 24px 64px rgba(0,0,0,.6),
                inset 0 1px 0 rgba(255,255,255,.03);
            animation: slideUp .4s cubic-bezier(.16,1,.3,1) both;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Badge / eyebrow */
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-family: var(--mono);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--accent);
            background: rgba(59,111,212,.1);
            border: 1px solid rgba(59,111,212,.2);
            border-radius: 6px;
            padding: 4px 10px;
            margin-bottom: 18px;
        }
        .eyebrow::before {
            content: "";
            width: 6px; height: 6px;
            border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 6px var(--accent);
            animation: pulse 2s ease-in-out infinite;
        }
        @@keyframes pulse {
            0%,100% { opacity: 1; }
            50%      { opacity: .4; }
        }

        h1 {
            font-family: var(--sans);
            font-size: 1.45rem;
            font-weight: 600;
            color: var(--text);
            letter-spacing: -.01em;
            margin-bottom: 6px;
        }

        .subtitle {
            font-size: .875rem;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 28px;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border);
        }

        /* Field groups */
        .field { margin-bottom: 18px; }

        .field-label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: var(--mono);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 8px;
        }

        .field-label .idx {
            font-size: 10px;
            color: var(--text-dim);
        }

        .field-input {
            position: relative;
        }

        input[type="password"] {
            display: block;
            width: 100%;
            height: 46px;
            padding: 0 14px;
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            font-family: var(--mono);
            font-size: .95rem;
            letter-spacing: .06em;
            transition: border-color .2s, box-shadow .2s, background .2s;
            outline: none;
        }

        input[type="password"]:focus {
            border-color: var(--border-focus);
            background: #111c35;
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

        input[type="password"]::placeholder {
            color: var(--text-dim);
            letter-spacing: .02em;
        }

        /* Divider before submit */
        .divider {
            border: none;
            border-top: 1px solid var(--border);
            margin: 24px 0 22px;
        }

        button[type="submit"] {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            height: 48px;
            background: var(--accent);
            color: #fff;
            font-family: var(--sans);
            font-size: .95rem;
            font-weight: 600;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            letter-spacing: .01em;
            position: relative;
            overflow: hidden;
            transition: background .2s, box-shadow .2s, transform .1s;
        }

        button[type="submit"]::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,.08) 0%, transparent 60%);
        }

        button[type="submit"]:hover {
            background: var(--accent-hover);
            box-shadow: 0 4px 20px rgba(59,111,212,.4);
            transform: translateY(-1px);
        }

        button[type="submit"]:active {
            transform: translateY(0);
        }

        /* Arrow icon on button */
        button[type="submit"] .arrow {
            font-size: 1rem;
            transition: transform .2s;
        }
        button[type="submit"]:hover .arrow {
            transform: translateX(3px);
        }

        /* Validation errors */
        .err-block {
            background: var(--danger-dim);
            border: 1px solid rgba(224,92,92,.3);
            border-radius: 9px;
            padding: 12px 14px;
            margin-bottom: 20px;
            font-size: .875rem;
            color: var(--danger);
            line-height: 1.5;
        }
        .err-block:empty { display: none; }

        /* Back link */
        .back-link {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 20px;
            font-family: var(--mono);
            font-size: .8rem;
            color: var(--text-dim);
            text-decoration: none;
            letter-spacing: .04em;
            transition: color .2s;
        }
        .back-link:hover { color: var(--text-muted); }
    </style>
</head>
<body>
<div class="card">
    <div class="eyebrow">root / смена пароля</div>
    <h1>Смена пароля</h1>
    <p class="subtitle">Первый вход с дефолтным паролем требует обязательной смены пароля перед продолжением работы.</p>

    <div asp-validation-summary="All" class="err-block"></div>

    <form method="post">
        <div class="field">
            <div class="field-label"><span class="idx">01</span> Текущий пароль</div>
            <input asp-for="CurrentPassword" type="password" autocomplete="current-password" placeholder="••••••••" />
        </div>

        <div class="field">
            <div class="field-label"><span class="idx">02</span> Новый пароль</div>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
        </div>

        <div class="field">
            <div class="field-label"><span class="idx">03</span> Подтверждение</div>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
        </div>

        <hr class="divider" />

        <button type="submit">
            Сохранить новый пароль
            <span class="arrow">→</span>
        </button>
    </form>

    <a class="back-link" href="/root/login">← вернуться ко входу</a>
</div>
</body>
</html>
