@page "/root/change-password"
@model Host.Pages.Root.ChangePasswordModel
@{
    ViewData["Title"] = "Change Root Password";
}

<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Change Root Password</title>
    <style>
        body { font-family: Segoe UI, sans-serif; margin: 0; background: #111; color: #eee; }
        .wrap { max-width: 420px; margin: 80px auto; padding: 24px; background: #1c1c1c; border-radius: 10px; }
        input { width: 100%; padding: 10px; margin: 6px 0 12px 0; border: 1px solid #444; border-radius: 6px; background: #0f0f0f; color: #eee; }
        button { width: 100%; padding: 10px; border: 0; border-radius: 6px; background: #1565c0; color: #fff; cursor: pointer; }
        .err { color: #ef5350; margin-bottom: 12px; }
        .hint { color: #bbb; margin-bottom: 14px; font-size: 14px; }
    </style>
</head>
<body>
<div class="wrap">
    <h2>Смена root-пароля</h2>
    <p class="hint">Первый вход с дефолтным паролем требует обязательной смены.</p>

    <div asp-validation-summary="All" class="err"></div>

    <form method="post">
        <label>Текущий пароль</label>
        <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />

        <label>Новый пароль</label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password" />

        <label>Подтверждение</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />

        <button type="submit">Сохранить пароль</button>
    </form>
</div>
</body>
</html>
