@page "/root/login"
@model Host.Pages.Root.LoginModel
@{
    ViewData["Title"] = "Вход в root-панель";
    ViewData["PageClass"] = "root-login-page";
}
<div class="auth-panel">
    <div class="eyebrow">root / auth</div>
    <h1 class="auth-title">Вход в root-панель</h1>
    <p class="auth-subtitle">Авторизация администратора для операций с зарплатой, инвентаризацией и настройками root-панели.</p>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="auth-error"></div>
    }

    <form method="post">
        <div class="field">
            <label class="field-label" asp-for="Username">Логин</label>
            <input asp-for="Username" autocomplete="username" />
        </div>

        <div class="field">
            <label class="field-label" asp-for="Password">Пароль</label>
            <input asp-for="Password" type="password" autocomplete="current-password" />
        </div>

        <div class="actions">
            <button class="btn btn-ok btn-block" type="submit">Войти</button>
        </div>
    </form>
</div>
